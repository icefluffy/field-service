<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_revision_workshop_list" model="ir.ui.view">
        <field name="name">fsm.revision.workshop.list</field>
        <field name="model">fsm.revision.workshop</field>
        <field name="arch" type="xml">
            <list>
                <field name="codes"/>
                <field name="name"/>
                <field name="xml_value" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="fsm_revision_workshop_form" model="ir.ui.view">
        <field name="name">fsm.revision.workshop.form</field>
        <field name="model">fsm.revision.workshop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="xml_value"/>
                        <field name="note"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="code_ids">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fsm_revision_workshop_search" model="ir.ui.view">
        <field name="name">fsm.revision.workshop.search</field>
        <field name="model">fsm.revision.workshop</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code_ids.name', 'ilike', self), ('xml_value', 'ilike', self)]"/>
                <field name="code_ids" string="Code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fsm_revision_workshop" model="ir.actions.act_window">
        <field name="name">Revision Workshops</field>
        <field name="res_model">fsm.revision.workshop</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fsm_revision_workshop_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a revision workshop.</p>
            <p>The codes of a workshop are the codes written in the revision frame of a wagon, e.g. 975 or RSN.</p>
        </field>
    </record>
</odoo>
