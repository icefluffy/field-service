<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_list_dropdown_one_click.ListSelectMenuField">
        <t t-if="props.readonly">
            <span t-esc="string" t-att-raw-value="value"/>
        </t>
        <t t-else="">
            <SelectMenu
                class="'o_list_select_menu border-0 w-100'"
                togglerClass="'o_input border-0 bg-transparent px-0 py-0 shadow-none text-start'"
                choices="choices"
                value="value"
                required="props.required"
                searchable="choices.length > 10"
                autoSort="false"
                placeholder="props.placeholder"
                onSelect.bind="onSelect"
            />
        </t>
    </t>
</templates>
