<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_client_order_form" model="ir.ui.view">
        <field name="name">fsm.client.order.form</field>
        <field name="model">fsm.client.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_dossiers" string="Add wagons" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_create_invoice" string="Create invoice"
                            type="object"
                            invisible="state == 'cancelled' or billing_status in ('nothing', 'invoiced')"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dossiers" type="object"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="dossier_count" widget="statinfo" string="Dossiers"/>
                        </button>
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="FSM Orders"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" placeholder="Client reference (order number, e-mail, ...)"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="dossier_count &gt; 0 and state != 'open'"/>
                            <field name="contact_id"/>
                            <field name="date_received"/>
                            <field name="date_planned"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="location_id"/>
                            <field name="dossier_progress"/>
                            <field name="billing_status"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_invoiced" invisible="invoice_count == 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dossiers" name="dossiers">
                            <field name="dossier_ids"
                                   context="{'default_client_order_id': id, 'default_customer_id': customer_id, 'default_customer_reference': reference, 'default_company_id': company_id, 'default_team_id': team_id, 'default_location_id': location_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="equipment_id"/>
                                    <field name="location_id"/>
                                    <field name="date_arrival" optional="show"/>
                                    <field name="date_planned" optional="show"/>
                                    <field name="inspection_progress"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state in ('planned', 'in_progress')"
                                           decoration-warning="state == 'awaiting_approval'"
                                           decoration-success="state in ('approved', 'closed')"/>
                                    <field name="billing_status" widget="badge"
                                           decoration-success="billing_status == 'invoiced'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Client Request" name="request">
                            <field name="description" placeholder="Paste or summarise the client's e-mail or order here. Attach the original e-mail/PDF in the chatter."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fsm_client_order_list" model="ir.ui.view">
        <field name="name">fsm.client.order.list</field>
        <field name="model">fsm.client.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="date_received"/>
                <field name="date_planned" optional="show"/>
                <field name="dossier_progress"/>
                <field name="user_id" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="billing_status" widget="badge"
                       decoration-success="billing_status == 'invoiced'"
                       decoration-warning="billing_status in ('to_invoice', 'partial')"/>
            </list>
        </field>
    </record>

    <record id="fsm_client_order_search" model="ir.ui.view">
        <field name="name">fsm.client.order.search</field>
        <field name="model">fsm.client.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="dossier_ids" string="Wagon / Dossier"
                       filter_domain="['|', ('dossier_ids.name', 'ilike', self), ('dossier_ids.equipment_id', 'ilike', self)]"/>
                <field name="user_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_customer" string="Client" context="{'group_by': 'customer_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_team" string="Team" context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fsm_client_order" model="ir.actions.act_window">
        <field name="name">Client Orders</field>
        <field name="res_model">fsm.client.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a client order</p>
            <p>One client order per client request (order, e-mail). Add its wagons:
               each gets its own dossier with the same reference, and the whole
               request can be quoted and invoiced at once.</p>
        </field>
    </record>
</odoo>
