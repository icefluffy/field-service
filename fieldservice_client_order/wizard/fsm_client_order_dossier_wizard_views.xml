<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_client_order_dossier_wizard_form" model="ir.ui.view">
        <field name="name">fsm.client.order.dossier.wizard.form</field>
        <field name="model">fsm.client.order.dossier.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>One dossier is created per wagon, with the client and reference of
                   the client order.</p>
                <group>
                    <field name="client_order_id" force_save="1"/>
                    <field name="equipment_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="location_id"/>
                    <field name="date_arrival"/>
                    <field name="date_planned"/>
                </group>
                <footer>
                    <button name="action_create" string="Create dossiers" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
