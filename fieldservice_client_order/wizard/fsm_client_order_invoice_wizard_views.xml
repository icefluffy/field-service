<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_client_order_invoice_wizard_form" model="ir.ui.view">
        <field name="name">fsm.client.order.invoice.wizard.form</field>
        <field name="model">fsm.client.order.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>One draft invoice for the selected orders of all dossiers, with a
                   section per dossier and the client reference as invoice reference.</p>
                <group>
                    <field name="client_order_id" force_save="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0"
                          decoration-muted="blocker">
                        <field name="selected" widget="boolean_toggle" readonly="blocker"/>
                        <field name="dossier_id" readonly="1" force_save="1"/>
                        <field name="equipment_id"/>
                        <field name="order_id" readonly="1" force_save="1"/>
                        <field name="stage_id"/>
                        <field name="blocker" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_invoice" string="Create draft invoice"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
