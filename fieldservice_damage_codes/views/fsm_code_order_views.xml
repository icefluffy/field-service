<odoo>
    <record id="fsm_order_form_codes" model="ir.ui.view">
        <field name="name">fsm.order.form.codes</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="fsm_code_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="action_fsm_codes" model="ir.actions.act_window">
        <field name="name">Damage Codes</field>
        <field name="res_model">fsm.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fsm_codes"
        name="Damage Codes"
        action="action_fsm_codes"
        groups="base.group_system"
        sequence="90"
    />
</odoo>