<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="fsm_order_form_release_wagon_deferred" model="ir.ui.view">
  <field name="name">fsm.order.form.release.wagon.deferred</field>
  <field name="model">fsm.order</field>
  <field name="inherit_id" ref="fieldservice_release.fsm_order_form_view_release"/>
  <field name="arch" type="xml">
   <xpath expr="//page[@name='release_to_service']" position="after">
<page name="release_wagon" string="Release wagon">
 <field name="release_id" invisible="1"/>
 <field name="release_wagon_state" invisible="1"/>
 <field name="release_wagon_snapshots_taken" invisible="1"/>
 <div class="alert alert-info" invisible="release_id">
  Prepare the Vrijgave draft here. Equipment, contractor costs and timesheets
  are copied only when Release to Service is confirmed.
 </div>
 <button name="action_prepare_wagon_release" string="Prepare draft release"
         type="object" class="btn-primary" invisible="release_id"/>
 <div invisible="not release_id">
  <group><group>
   <button name="action_preview_wagon_release" string="Preview Vrijgave"
           type="object" icon="fa-eye" class="btn-secondary"/>
   <button name="action_print_wagon_release" string="Print Vrijgave"
           type="object" icon="fa-print" class="btn-secondary"/>
  </group><group>
   <button name="action_open_release_form" string="Open release form"
           type="object" class="btn-secondary"/>
   <button name="action_fill_wagon_release" string="Fill missing identification"
           type="object" class="btn-secondary" invisible="release_wagon_state != 'draft'"/>
   <button name="action_finalize_wagon_release" string="Release to Service"
           type="object" class="btn-primary" invisible="release_wagon_state != 'draft'"
           confirm="Capture the current equipment, contractor costs and timesheets and mark this release as released? Review the Vrijgave identification, checks, decision and signatures first."/>
  </group></group>
  <div class="alert alert-warning" invisible="release_wagon_state != 'draft'">
   Draft: snapshot lists are not finalized. Previewing or printing does not
   approve the vehicle. Check all manual information before final release.
  </div>
  <group string="Release status"><field name="release_wagon_state"/>
   <field name="release_wagon_snapshots_taken"/>
  </group>
  <group string="Identification"><group><field name="release_vg_short_id" readonly="release_wagon_state != 'draft'" /><field name="release_vg_evn" readonly="release_wagon_state != 'draft'" /><field name="release_vg_date" readonly="release_wagon_state != 'draft'" /><field name="release_vg_place" readonly="release_wagon_state != 'draft'" /></group><group><field name="release_vg_customer_ref" readonly="release_wagon_state != 'draft'" /><field name="release_vg_order_ref" readonly="release_wagon_state != 'draft'" /><field name="release_vg_technicians" readonly="release_wagon_state != 'draft'" /></group></group><group string="Work details"><field name="release_vg_description" readonly="release_wagon_state != 'draft'" /><field name="release_vg_specific_checks" readonly="release_wagon_state != 'draft'" /></group><group string="Inspection checklist"><group><field name="release_vg_check_1" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_2" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_3" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_4" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_5" readonly="release_wagon_state != 'draft'" /></group><group><field name="release_vg_check_6_label" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_6" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_7_label" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_7" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_8_label" readonly="release_wagon_state != 'draft'" /><field name="release_vg_check_8" readonly="release_wagon_state != 'draft'" /></group></group><group string="Remarks and resolved defects"><field name="release_vg_remarks" readonly="release_wagon_state != 'draft'" /><field name="release_vg_resolved_defects" readonly="release_wagon_state != 'draft'" /></group><group string="Return-to-service decision"><field name="release_vg_decision" readonly="release_wagon_state != 'draft'" /><field name="release_vg_unrestricted_remarks" readonly="release_wagon_state != 'draft'" /><field name="release_vg_restricted_remarks" readonly="release_wagon_state != 'draft'" /><field name="release_vg_refused_remarks" readonly="release_wagon_state != 'draft'" /><field name="release_vg_work_only_remarks" readonly="release_wagon_state != 'draft'" /></group><group string="Signatures"><group><field name="release_vg_technician_name" readonly="release_wagon_state != 'draft'" /><field name="release_vg_technician_signature" readonly="release_wagon_state != 'draft'" widget="signature"/></group><group><field name="release_vg_responsible_name" readonly="release_wagon_state != 'draft'" /><field name="release_vg_responsible_signature" readonly="release_wagon_state != 'draft'" widget="signature"/></group></group></div></page>
   </xpath>
  </field>
 </record>
 <record id="fsm_release_form_deferred_snapshot_status" model="ir.ui.view">
  <field name="name">fsm.release.form.deferred.snapshot.status</field>
  <field name="model">fsm.release</field>
  <field name="inherit_id" ref="fieldservice_release.fsm_release_form_view"/>
  <field name="arch" type="xml">
   <xpath expr="//header/button[@name='action_release']" position="attributes">
    <attribute name="confirm">Capture the current equipment, contractor costs and timesheets and mark this release as released? Review the Vrijgave information first.</attribute>
   </xpath>
   <xpath expr="//sheet/notebook" position="before">
    <group string="Final snapshots">
     <field name="snapshots_taken"/>
     <field name="snapshots_taken_at"/>
     <field name="snapshots_taken_by"/>
    </group>
    <div class="alert alert-info" invisible="state != 'draft'">
     Under the new workflow, snapshots are taken on Release to Service,
     not during draft preparation, preview or printing.
    </div>
   </xpath>
  </field>
 </record>
</odoo>
