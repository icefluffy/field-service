<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="fsm_release_list_view" model="ir.ui.view">
        <field name="name">fsm.release.list</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <list string="Release Forms">
                <field name="name"/>
                <field name="fsm_order_id"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="fsm_release_form_view" model="ir.ui.view">
        <field name="name">fsm.release.form</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <form string="Release Form">
                <header>
                    <button name="action_preview_vrijgave" string="Preview Vrijgave" type="object" class="btn-secondary" icon="fa-eye"/>
                    
                    <button name="action_print_vrijgave" string="Print Vrijgave" type="object" class="btn-secondary" icon="fa-print"/>

                    <button name="action_preview_release_form" string="Preview Mobile Release Form" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button name="%(action_report_fsm_release)d" string="Print Mobile Release Form" type="action" class="oe_highlight" icon="fa-print"/>
                    <button name="action_release" string="Release to Service" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <!-- Release identification -->
                    <group>
                        <group>
                            <field name="fsm_order_id"/>
                            <field name="partner_id"/>
                            <field name="wagennummer_formatted" string="Wagon"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                        </group>
                    </group>

                    <!-- Repair report vehicle / revision information -->
                    <group>
                        <group string="Wagon information">
                            <field name="wagon_number_old"/>
                            <field name="own_weight"/>
                            <field name="maintenance_level"/>
                        </group>
                        <group string="Revision / Brakes">
                            <field name="revision_type"/>
                            <field name="revision_cycle"/>
                            <field name="revision_date"/>
                            <field name="revision_extension"/>
                            <field name="brake_type"/>
                            <field name="brake_deadline"/>
                        </group>
                    </group>

                    <!-- Repair-report text fields, directly on the main page -->
                    <group string="Repair Work Performed">
                        <field name="work_performed" nolabel="1"/>
                    </group>
                    <group string="Postponed Work">
                        <field name="postponed_work" nolabel="1"/>
                    </group>
                    <group string="Replaced Components">
                        <field name="replaced_components" nolabel="1"/>
                    </group>
                    <group string="Other Information">
                        <field name="other_information" nolabel="1"/>
                    </group>
                    <group>
                        <group string="Release Confirmation">
                            <field name="repair_confirmed"/>
                            <field name="release_confirmed"/>
                        </group>
                        <group string="Issue">
                            <field name="issue_date"/>
                        </group>
                    </group>

                    <notebook>
<page name="vrijgave" string="Vrijgave">
 <div class="text-muted">Review all values before printing. Blank checks are not approvals. Printing does not release the vehicle or change its status.</div>
 <group string="Identification"><field name="vrijgave_short_id"/><field name="vrijgave_evn"/><field name="vrijgave_date"/><field name="vrijgave_place"/><field name="vrijgave_customer_ref"/><field name="vrijgave_order_ref"/><field name="vrijgave_technicians"/></group><group string="Work and checks"><field name="vrijgave_description"/><field name="vrijgave_specific_checks"/><field name="vrijgave_check_1"/><field name="vrijgave_check_2"/><field name="vrijgave_check_3"/><field name="vrijgave_check_4"/><field name="vrijgave_check_5"/><field name="vrijgave_check_6_label"/><field name="vrijgave_check_6"/><field name="vrijgave_check_7_label"/><field name="vrijgave_check_7"/><field name="vrijgave_check_8_label"/><field name="vrijgave_check_8"/></group><group string="Remarks and defects"><field name="vrijgave_remarks"/><field name="vrijgave_resolved_defects"/></group>
<group string="Return to service"><field name="vrijgave_decision"/><field name="vrijgave_unrestricted_remarks"/><field name="vrijgave_restricted_remarks"/><field name="vrijgave_refused_remarks"/><field name="vrijgave_work_only_remarks"/></group><group string="Signatures"><group><field name="vrijgave_technician_name"/><field name="vrijgave_technician_signature" widget="signature"/></group><group><field name="vrijgave_responsible_name"/><field name="vrijgave_responsible_signature" widget="signature"/></group></group></page>
                        <page name="contractor_costs" string="Contractor Costs">
                            <field name="contractor_cost_line_ids" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group>
                                <field name="contractor_total" readonly="1"/>
                            </group>
                        </page>

                        <page name="employee_timesheets" string="Employee Timesheets">
                            <field name="timesheet_line_ids" nolabel="1">
                                <list create="0" delete="0" default_order="date">
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="unit_amount" string="Duration" widget="float_time"/>
                                    <field name="project_id"/>
                                    <field name="task_id"/>
                                </list>
                            </field>
                            <group>
                                <field name="employee_time_total" readonly="1" widget="float_time"/>
                            </group>
                        </page>

                        <page name="equipment" string="Equipment">
                            <field name="equipment_line_ids" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="equipment_id"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                </list>
                            </field>
                        </page>

                        <page name="remarks" string="Remarks">
                            <field name="remarks" placeholder="Enter release-to-service remarks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_order_equipment_under_location" model="ir.ui.view">
        <field name="name">fsm.order.equipment.under.location</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/group/group/field[@name='location_id']" position="after">
                <field name="equipment_id" string="Equipment" options="{'no_create': False, 'no_create_edit': False, 'no_quick_create': True}" groups="fieldservice.group_fsm_equipment"/>
            </xpath>

            <xpath expr="//page[@name='equipements_page']" position="replace"/>

        </field>
    </record>
</odoo>
