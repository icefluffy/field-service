<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="fsm_release_list_view" model="ir.ui.view">
        <field name="name">fsm.release.list</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <list string="Release Forms">
                <field name="name"/>
                <field name="fsm_order_id"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="fsm_release_form_view" model="ir.ui.view">
        <field name="name">fsm.release.form</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <form string="Release Form">
                <header>
                    <button name="action_release" string="Release to Service" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released,cancelled"/>
                </header>

                <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
 <group><group><field name="fsm_order_id"/><field name="partner_id"/></group>
 <group><field name="location_id"/><field name="vrijgave_evn" string="Vehicle / EVN" readonly="1"/></group></group>
 <notebook>
  <page name="vrijgave" string="Release">
   <div name="vrijgave_print_buttons" class="d-flex gap-2 mb-3"><button name="action_preview_vrijgave" string="Preview Release" type="object" class="btn-secondary" icon="fa-eye"/>
                    
                    <button name="action_print_vrijgave" string="Print Release" type="object" class="btn-primary" icon="fa-print"/>

                    </div>
   <group string="Identification"><group>
    <field name="vrijgave_short_id" string="Short vehicle ID"/>
    <field name="vrijgave_evn" string="Full EVN"/>
    <field name="vrijgave_date" string="Date"/>
   </group><group>
    <field name="vrijgave_place"/>
    <field name="vrijgave_customer_ref"/>
    <field name="vrijgave_order_ref"/>
    <field name="vrijgave_technicians"/>
   </group></group>
   <group string="Work"><field name="vrijgave_description"/>
    <field name="vrijgave_specific_checks"/>
   </group>
   <group string="Checks"><group>
    <field name="vrijgave_check_1"/>
    <field name="vrijgave_check_2"/>
    <field name="vrijgave_check_3"/>
    <field name="vrijgave_check_4"/>
    <field name="vrijgave_check_5"/>
   </group><group string="Additional checks">
    <field name="vrijgave_check_6_label"/>
    <field name="vrijgave_check_6" string="Result 6"/>
    <field name="vrijgave_check_7_label"/>
    <field name="vrijgave_check_7" string="Result 7"/>
    <field name="vrijgave_check_8_label"/>
    <field name="vrijgave_check_8" string="Result 8"/>
   </group></group>
   <group string="Remarks and defects">
    <field name="vrijgave_remarks"/>
    <field name="vrijgave_resolved_defects"/>
   </group>
   <group string="Return to service">
    <field name="vrijgave_decision"/>
    <field name="vrijgave_unrestricted_remarks" string="Decision remarks" invisible="vrijgave_decision != 'unrestricted'"/>
    <field name="vrijgave_restricted_remarks" string="Restrictions" invisible="vrijgave_decision != 'restricted'"/>
    <field name="vrijgave_refused_remarks" string="Reason for refusal" invisible="vrijgave_decision != 'refused'"/>
    <field name="vrijgave_work_only_remarks" string="Scope of release" invisible="vrijgave_decision != 'work_only'"/>
   </group>
   <group string="Signatures"><group>
    <field name="vrijgave_technician_name"/>
    <field name="vrijgave_technician_signature" widget="signature"/>
   </group><group>
    <field name="vrijgave_responsible_name"/>
    <field name="vrijgave_responsible_signature" widget="signature"/>
   </group></group>
  </page>
  <page name="mobile_release" string="Mobile Release Form">
   <div name="mobile_print_buttons" class="d-flex gap-2 mb-3"><button name="action_preview_release_form" string="Preview Mobile Release Form" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button name="%(action_report_fsm_release)d" string="Print Mobile Release Form" type="action" class="btn-primary" icon="fa-print"/>
                    </div>
   <group string="Vehicle and maintenance"><group>
    <field name="wagon_number_old"/>
    <field name="own_weight"/>
    <field name="maintenance_level"/>
   </group><group>
    <field name="revision_type"/><field name="revision_cycle"/>
    <field name="revision_date"/><field name="revision_extension"/>
    <field name="brake_type"/><field name="brake_deadline"/>
   </group></group>
   <group string="Repair work performed"><field name="work_performed" nolabel="1"/></group>
   <group string="Postponed work"><field name="postponed_work" nolabel="1"/></group>
   <group string="Replaced components"><field name="replaced_components" nolabel="1"/></group>
   <group string="Other information"><field name="other_information" nolabel="1"/></group>
   <group string="Release remarks"><field name="remarks" nolabel="1"/></group>
   <group><group string="Confirmation">
    <field name="repair_confirmed"/>
    <field name="release_confirmed"/>
   </group><group string="Issue">
    <field name="issue_date"/>
   </group></group>
  </page>
 </notebook>
</sheet></form>
        </field>
    </record>
    <record id="fsm_order_equipment_under_location" model="ir.ui.view">
        <field name="name">fsm.order.equipment.under.location</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/group/group/field[@name='location_id']" position="after">
                <field name="equipment_id" string="Equipment" options="{'no_create': False, 'no_create_edit': False, 'no_quick_create': True}" groups="fieldservice.group_fsm_equipment"/>
            </xpath>

            <xpath expr="//page[@name='equipements_page']" position="replace"/>

        </field>
    </record>
</odoo>
