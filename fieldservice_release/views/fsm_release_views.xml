<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: useful later from a menu or directly from an order. -->
    <record id="fsm_release_list_view" model="ir.ui.view">
        <field name="name">fsm.release.list</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <list string="Release Forms">
                <field name="name"/>
                <field name="fsm_order_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view: the record created by Create Release Form opens here. -->
    <record id="fsm_release_form_view" model="ir.ui.view">
        <field name="name">fsm.release.form</field>
        <field name="model">fsm.release</field>
        <field name="arch" type="xml">
            <form string="Release Form">

                <header>
                    <button
                        name="action_release"
                        string="Release to Service"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'cancelled'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,released,cancelled"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="fsm_order_id"/>
                    </group>

                    <notebook>
                        <page name="remarks" string="Remarks">
                            <field
                                name="remarks"
                                placeholder="Enter release-to-service remarks..."
                            />
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

</odoo>