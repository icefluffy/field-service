<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fsm_order_form_view_release" model="ir.ui.view">
        <field name="name">fsm.order.form.release</field>
        <field name="model">fsm.order</field>

        <field name="inherit_id"
               ref="fieldservice_isp_account.fsm_order_form_isp_account"/>

        <field name="arch" type="xml">

            <!-- Smart button: visible only after a Release Form exists. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_release_form"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="not release_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Release Form</span>
                    </div>
                </button>
            </xpath>

            <!-- New tab directly after the Accounting tab. -->
            <xpath expr="//page[@name='accounting']" position="after">
                <page name="release_to_service" string="Release to Service">

                    <group>
                        <field
                            name="release_remarks"
                            placeholder="Enter the remarks for the release form..."
                        />
                    </group>

                    <group string="Release Form">
                        <field
                            name="release_id"
                            readonly="1"
                            options="{'no_create': True, 'no_open': False}"
                        />
                    </group>

                </page>
            </xpath>

            <!-- Appears at the same stage as Create Invoice. -->
            <xpath expr="//button[@name='account_create_invoice']" position="after">
                <button
                    id="account_create_release_form"
                    name="action_create_release_form"
                    string="Create Release Form"
                    class="oe_highlight"
                    type="object"
                    groups="fieldservice.group_fsm_dispatcher"
                    invisible="account_stage != 'confirmed' or release_id"
                />
            </xpath>

        </field>
    </record>


    <!-- Seth wants to hide unwanted fields  -->
    <record id="fsm_order_form_hide_unused_fields" model="ir.ui.view">
        <field name="name">fsm.order.form.hide.unused.fields</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
    
            <xpath expr="//field[@name='opportunity_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
    
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
    
            <xpath expr="//field[@name='project_task_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
    
            <xpath expr="//field[@name='size_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
    
            <xpath expr="//label[@for='size_value']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
    
            <xpath expr="//field[@name='size_value']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='size_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!-- hide types field -->
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!-- move location and contac tto the left -->
            <xpath expr="//field[@name='customer_id']" position="move">
                <xpath expr="//field[@name='tag_ids']" position="after"/>
            </xpath>
            
            <xpath expr="//field[@name='location_id']" position="move">
                <xpath expr="//field[@name='customer_id']" position="after"/>
            </xpath>
    
        </field>
    </record>
</odoo>
