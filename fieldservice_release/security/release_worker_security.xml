    <record id="rule_worker_drafts_assigned_orders" model="ir.rule">
        <field name="name">
            Worker release preparers: read assigned orders only
        </field>
    
        <field name="model_id" ref="fieldservice.model_fsm_order"/>
    
        <field name="domain_force">
            (
                [
                    '&amp;',
                    ('company_id', 'in', company_ids),
                    '|',
                    ('person_id.partner_id', '=', user.partner_id.id),
                    ('person_ids.partner_id', '=', user.partner_id.id)
                ]
                if (
                    user.has_group(
                        'fieldservice_release.group_release_draft_preparer'
                    )
                    and not user.has_group(
                        'fieldservice.group_fsm_dispatcher'
                    )
                    and not user.has_group(
                        'fieldservice.group_fsm_manager'
                    )
                )
                else [(1, '=', 1)]
            )
        </field>
    
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
