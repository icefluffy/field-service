<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fsm_release_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <div class="page"
                         style="font-size:11px; font-family:Arial, sans-serif; color:#000;">

                        <h2 style="text-decoration:underline; margin-bottom:10px;">
                            Instandsetzungsbericht Mobile Instandsetzung
                        </h2>

                        <!-- Top identification block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Wagennummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Auftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>FW. Nummer:</strong>
                                </td>
                                <td rowspan="4"
                                    style="border:1px solid #000; padding:4px; width:25%; text-align:center; vertical-align:middle;">
                                    <img t-if="o.fsm_order_id.company_id.logo"
                                         t-att-src="image_data_uri(o.fsm_order_id.company_id.logo)"
                                         style="max-width:140px;"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <t t-if="o.equipment_line_ids">
                                        <span t-field="o.equipment_line_ids[0].lot_id"/>
                                    </t>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.name"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.name"/>
                                </td>
                            </tr>

                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Halter / ECM:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Kundenauftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Erstellt am:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.partner_id"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.name"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </table>

                        <!-- Execution date / maintenance level -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <strong>Mobile Instandsetzung durchgeführt am:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <strong>Durchgeführte Instandhaltungsstufe:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.date_start"
                                          t-options='{"widget": "date"}'/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <!-- No maintenance-level field exists yet. -->
                                </td>
                            </tr>
                        </table>

                        <!-- Wagon old number / weight / revision cycle table -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Wagennummer Alt:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Eigengewicht:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Art:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Zyklus:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Datum:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <strong>Verlängerung:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;">
                                    Revision
                                </td>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;">
                                    Bremsrevision
                                </td>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;">
                                    Frist
                                </td>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                                <td style="border:1px solid #000; padding:4px;"/>
                            </tr>
                        </table>

                        <!-- Work performed -->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">
                                Durchgeführte Instandsetzungsarbeiten:
                            </div>

                            <div style="padding:6px; min-height:180px; white-space:pre-wrap;">
                                <span t-field="o.remarks"/>
                            </div>
                        </div>

                        <!-- Postponed work -->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">
                                Zurückgestellte Arbeiten (einschließlich Begründung):
                            </div>

                            <div style="padding:6px; min-height:70px;">
                                <!-- No matching field exists yet. -->
                            </div>
                        </div>

                        <!-- Replaced components -->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">
                                Ausgetauschte Komponenten:
                            </div>

                            <div style="padding:6px; min-height:60px;">
                                <t t-if="o.contractor_cost_line_ids">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <t t-foreach="o.contractor_cost_line_ids"
                                           t-as="line">
                                            <tr>
                                                <td style="border:0; padding:1px; width:65%;">
                                                    <span t-field="line.product_id"/>
                                                </td>
                                                <td style="border:0; padding:1px; width:15%;">
                                                    Qty:
                                                    <span t-field="line.quantity"/>
                                                </td>
                                                <td style="border:0; padding:1px; width:20%;">
                                                    <span t-field="line.price_unit"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </t>

                                <t t-if="not o.contractor_cost_line_ids">
                                    No replaced components recorded.
                                </t>
                            </div>
                        </div>

                        <!-- Other information -->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">
                                Sonstige Angaben (nach Vorgabe des Halters/ECM):
                            </div>

                            <div style="padding:6px; min-height:60px; white-space:pre-wrap;">
                                <t t-if="o.fsm_order_id.resolution">
                                    <span t-field="o.fsm_order_id.resolution"/>
                                </t>
                            </div>
                        </div>

                        <!-- Release confirmation -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:4px; width:22%;">
                                    <span t-if="o.state == 'released'">☒</span>
                                    <span t-else="">☐</span>
                                    Instandsetzung
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    Die beschriebenen Arbeitsschritte wurden korrekt und
                                    vollständig ausgeführt.
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-if="o.state == 'released'">☒</span>
                                    <span t-else="">☐</span>
                                    Betriebsfreigabe
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    Die zusätzliche Kontrolle nach VPI-EMG 01, Anhang 19,
                                    ergab keine Beanstandung. Wir bescheinigen hiermit,
                                    dass dieser Wagen den einschlägigen Gesetzen und
                                    Verordnungen, den Vorschriften des Halters/ECM und
                                    dem RID, sofern zutreffend, entspricht.
                                </td>
                            </tr>
                        </table>

                        <!-- Signatory / contact block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:40%;">
                                    <strong>Name (des verantwortlichen Mitarbeiters):</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Telefonnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Ausstellungsdatum:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>E-Mail:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.name"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.street"/>
                                    <t t-if="o.fsm_order_id.company_id.street2">
                                        <br/>
                                        <span t-field="o.fsm_order_id.company_id.street2"/>
                                    </t>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.zip"/>
                                    <span t-field="o.fsm_order_id.company_id.city"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.person_id.name"/>
                                    <i> (signed digitally)</i>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.phone"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.email"/>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top:10px; font-size:9px; color:#555;">
                            VPI-EMG 10 Anhang 2 | Stand: 01.12.2024
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>