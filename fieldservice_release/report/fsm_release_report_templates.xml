                        <!-- Postponed / uncompleted FSM activities -->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">
                                Zurückgestellte Arbeiten (einschließlich Begründung):
                            </div>
                        
                            <div style="padding:6px; min-height:70px;">
                                <t t-if="o.fsm_order_id.order_activity_ids.filtered(lambda activity: activity.state != 'done')">
                                    <t t-foreach="o.fsm_order_id.order_activity_ids" t-as="activity">
                                        <t t-if="activity.state != 'done'">
                                            <div style="margin-bottom:3px;">
                                                <t t-if="activity.ref">
                                                    <strong><span t-field="activity.ref"/></strong>
                                                    —
                                                </t>
                        
                                                <span t-field="activity.name"/>
                        
                                                <t t-if="activity.state == 'cancel'">
                                                    <span style="color:#b00020;"> (Cancelled)</span>
                                                </t>
                        
                                                <t t-if="activity.state == 'todo'">
                                                    <span style="color:#555;"> (Not completed)</span>
                                                </t>
                                            </div>
                                        </t>
                                    </t>
                                </t>
                        
                                <t t-else="">
                                    <span style="color:#555;">
                                        No postponed or uncompleted activities.
                                    </span>
                                </t>
                            </div>
                        </div>

                        <!-- Replaced components = Ausgetauschte Komponenten:-->
                        <div style="border:1px solid #000; margin-bottom:6px;">
                            <div style="background:#e6e6e6; padding:4px; font-weight:bold;">Ausgetauschte Komponenten:</div>
                            <div style="padding:6px; min-height:60px;">
                                <t t-if="o.contractor_cost_line_ids">
                                    <t t-foreach="o.contractor_cost_line_ids" t-as="cost_line">
                                        <tr>
                                            <td>
                                                <span t-field="cost_line.product_id"/> Qty: <span t-field="cost_line.quantity"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="5">
                                        <!--    No contractor-cost lines recorded. -->
                                        </td>
                                    </tr>
                                </t>
                              <!--  <span t-field="o.x_replaced_components"/> -->
                            </div>
                        </div>

                        <!-- Other information -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Sonstige Angaben (nach Vorgabe des Halters/ECM)
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:6px; min-height:45px; white-space:pre-wrap;">
                                    <t t-if="o.fsm_order_id.resolution">
                                        <span t-field="o.fsm_order_id.resolution"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Release approval -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Release Approval
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <span t-if="o.state == 'released'" style="font-size:12px; font-weight:bold;">☒</span>
                                    <span t-else="" style="font-size:12px; font-weight:bold;">☐</span>
                                    Equipment released to service
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <span t-if="o.state == 'released'" style="font-size:12px; font-weight:bold;">☒</span>
                                    <span t-else="" style="font-size:12px; font-weight:bold;">☐</span>
                                    Customer informed
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px; height:55px;">
                                    Released by:
                                    <br/><br/>
                                    <span t-field="o.fsm_order_id.person_id.name"/>
                                    <br/><br/>
                                    Signature:
                                </td>
                                <td style="border:1px solid #000; padding:4px; height:55px;">
                                    Customer acceptance:
                                    <br/><br/><br/>
                                    Signature:
                                </td>
                            </tr>
                        </table>

                        <!-- Signatory / company block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:40%;">
                                    <strong>Name (des verantwortlichen Mitarbeiters):</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Telefonnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Ausstellungsdatum:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>E-Mail:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.name"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.street"/>
                                    <t t-if="o.fsm_order_id.company_id.street2">
                                        <br/>
                                        <span t-field="o.fsm_order_id.company_id.street2"/>
                                    </t>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.zip"/>
                                    <span t-field="o.fsm_order_id.company_id.city"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.person_id.name"/>
                                    <i> (signed digitally)</i>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.phone"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.email"/>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top:10px; font-size:9px; color:#555; text-align:center;">
                            VPI-EMG 10 Anhang 2 | Stand: 01.12.2024 |
                            Generated from Field Service Order
                            <span t-field="o.fsm_order_id.name"/>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
