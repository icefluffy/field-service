<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fsm_release_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <div class="page"
                         style="font-size:11px; font-family:Arial, sans-serif; color:#000;">

                        <h2 style="text-decoration:underline; margin-bottom:10px;">
                            Instandsetzungsbericht Mobile Instandsetzung
                        </h2>

                        <!-- Top identification block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Wagennummer</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Auftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>FW. Nummer:</strong>
                                </td>
                                <td rowspan="4"
                                    style="border:1px solid #000; padding:4px; width:25%; text-align:center; vertical-align:middle;">
                                    <img t-if="o.fsm_order_id.company_id.logo"
                                        t-att-src="image_data_uri(o.fsm_order_id.company_id.logo)"
                                        style="max-width:140px;"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <t t-if="o.equipment_line_ids">
                                        <span t-field="o.wagennummer_formatted"/>
                                    </t>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.name"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.name"/>
                                </td>
                            </tr>

                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>HALTER / ECM:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Kundenauftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Erstellt am:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.equipment_line_ids[0].equipment_id.managed_by_id"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.customer_order_number"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.actual_release_date"
                                        t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </table>

                        <!-- Customer and service information -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:4px; width:60%; background:#e5e5e5; font-weight:bold;">
                                    Mobile Instandsetzung durchgefürt am:
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:40%; background:#e5e5e5; font-weight:bold;">
                                    Durchgeführte Instandhaltungsstufe:
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    Current Date?
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    G3 of iets anders, en van waar te halen?
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px; background:#e5e5e5; font-weight:bold;">
                                    Halter / ECM
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.partner_id"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; background:#e5e5e5; font-weight:bold;">
                                    Erstellt am
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </table>

                        <!-- Equipment -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Equipment / Vehicle
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th style="border:1px solid #000; padding:4px; width:8%;">No.</th>
                                    <th style="border:1px solid #000; padding:4px; width:35%;">Equipment</th>
                                    <th style="border:1px solid #000; padding:4px; width:35%;">Product</th>
                                    <th style="border:1px solid #000; padding:4px; width:22%;">Serial Number</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.equipment_line_ids">
                                    <t t-foreach="o.equipment_line_ids" t-as="equipment_line">
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-esc="equipment_line_index + 1"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="equipment_line.equipment_id"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="equipment_line.product_id"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="equipment_line.lot_id"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="4">
                                            No equipment recorded.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Work performed -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Durchgeführte Instandsetzungsarbeiten
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:6px; min-height:70px; white-space:pre-wrap;">
                                    <t t-if="o.remarks">
                                        <span t-field="o.remarks"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Contractor work / replaced components -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Contractor Work and Replaced Components
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th style="border:1px solid #000; padding:4px; width:8%;">No.</th>
                                    <th style="border:1px solid #000; padding:4px;">Product / Component</th>
                                    <th style="border:1px solid #000; padding:4px; width:15%;">Quantity</th>
                                    <th style="border:1px solid #000; padding:4px; width:18%;">Unit Price</th>
                                    <th style="border:1px solid #000; padding:4px; width:18%;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.contractor_cost_line_ids">
                                    <t t-foreach="o.contractor_cost_line_ids" t-as="cost_line">
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-esc="cost_line_index + 1"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="cost_line.product_id"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="cost_line.quantity"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="cost_line.price_unit"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="cost_line.subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="5">
                                            No contractor-cost lines recorded.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold;"
                                        colspan="4">
                                        Contractor Total
                                    </td>
                                    <td style="border:1px solid #000; padding:4px; font-weight:bold;">
                                        <span t-field="o.contractor_total"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Employee timesheets, including Time Type -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Employee Timesheets
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th style="border:1px solid #000; padding:4px; width:12%;">Date</th>
                                    <th style="border:1px solid #000; padding:4px; width:18%;">Employee</th>
                                    <th style="border:1px solid #000; padding:4px; width:15%;">Time Type</th>
                                    <th style="border:1px solid #000; padding:4px;">Description</th>
                                    <th style="border:1px solid #000; padding:4px; width:12%;">Duration</th>
                                    <th style="border:1px solid #000; padding:4px; width:15%;">Project / Task</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.timesheet_line_ids">
                                    <t t-foreach="o.timesheet_line_ids" t-as="time_line">
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.date"
                                                      t-options='{"widget": "date"}'/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.employee_id"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.product_id"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.description"/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.unit_amount"
                                                      t-options='{"widget": "float_time"}'/>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <span t-field="time_line.project_id"/>
                                                <t t-if="time_line.task_id">
                                                    /
                                                    <span t-field="time_line.task_id"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="6">
                                            No employee-timesheet lines recorded.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold;"
                                        colspan="4">
                                        Total Employee Hours
                                    </td>
                                    <td style="border:1px solid #000; padding:4px; font-weight:bold;">
                                        <span t-field="o.employee_time_total"
                                              t-options='{"widget": "float_time"}'/>
                                    </td>
                                    <td style="border:1px solid #000; padding:4px;"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Other information -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Sonstige Angaben (nach Vorgabe des Halters/ECM)
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:6px; min-height:45px; white-space:pre-wrap;">
                                    <t t-if="o.fsm_order_id.resolution">
                                        <span t-field="o.fsm_order_id.resolution"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Release approval -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Release Approval
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <span t-if="o.state == 'released'" style="font-size:12px; font-weight:bold;">☒</span>
                                    <span t-else="" style="font-size:12px; font-weight:bold;">☐</span>
                                    Equipment released to service
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:50%;">
                                    <span t-if="o.state == 'released'" style="font-size:12px; font-weight:bold;">☒</span>
                                    <span t-else="" style="font-size:12px; font-weight:bold;">☐</span>
                                    Customer informed
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px; height:55px;">
                                    Released by:
                                    <br/><br/>
                                    <span t-field="o.fsm_order_id.person_id.name"/>
                                    <br/><br/>
                                    Signature:
                                </td>
                                <td style="border:1px solid #000; padding:4px; height:55px;">
                                    Customer acceptance:
                                    <br/><br/><br/>
                                    Signature:
                                </td>
                            </tr>
                        </table>

                        <!-- Signatory / company block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:40%;">
                                    <strong>Name (des verantwortlichen Mitarbeiters):</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Telefonnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>Ausstellungsdatum:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:20%;">
                                    <strong>E-Mail:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.name"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.street"/>
                                    <t t-if="o.fsm_order_id.company_id.street2">
                                        <br/>
                                        <span t-field="o.fsm_order_id.company_id.street2"/>
                                    </t>
                                    <br/>

                                    <span t-field="o.fsm_order_id.company_id.zip"/>
                                    <span t-field="o.fsm_order_id.company_id.city"/>
                                    <br/>

                                    <span t-field="o.fsm_order_id.person_id.name"/>
                                    <i> (signed digitally)</i>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.phone"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.email"/>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top:10px; font-size:9px; color:#555; text-align:center;">
                            VPI-EMG 10 Anhang 2 | Stand: 01.12.2024 |
                            Generated from Field Service Order
                            <span t-field="o.fsm_order_id.name"/>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
