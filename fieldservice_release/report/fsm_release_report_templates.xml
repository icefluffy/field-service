<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fsm_release_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <div class="page"
                         style="font-size:11px; font-family:Arial, sans-serif; color:#000;">

                        <h2 style="text-decoration:underline; margin-bottom:10px;">
                            Instandsetzungsbericht Mobile Instandsetzung
                        </h2>

                        <!-- Top identification block -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Wagennummer</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Auftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>FW. Nummer:</strong>
                                </td>
                                <td rowspan="4"
                                    style="border:1px solid #000; padding:4px; width:25%; text-align:center; vertical-align:middle;">
                                    <img t-if="o.fsm_order_id.company_id.logo"
                                        t-att-src="image_data_uri(o.fsm_order_id.company_id.logo)"
                                        style="max-width:140px;"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <t t-if="o.equipment_line_ids">
                                        <span t-field="o.wagennummer_formatted"/>
                                    </t>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.name"/>
                                </td>

                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.fsm_order_id.company_id.name"/>
                                </td>
                            </tr>

                            <tr style="background:#e6e6e6;">
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>HALTER / ECM:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Kundenauftragsnummer:</strong>
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:25%;">
                                    <strong>Erstellt am:</strong>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.equipment_line_ids[0].equipment_id.managed_by_id"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.customer_order_number"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="o.actual_release_date"
                                        t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </table>

                        <!-- second table -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <tr>
                                <td style="border:1px solid #000; padding:4px; width:60%; background:#e5e5e5; font-weight:bold;">
                                    Mobile Instandsetzung durchgefürt am:
                                </td>
                                <td style="border:1px solid #000; padding:4px; width:40%; background:#e5e5e5; font-weight:bold;">
                                    Durchgeführte Instandhaltungsstufe:
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:4px;">
                                    Current Date?
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    G3 of iets anders, en van waar te halen?
                                </td>
                            </tr>
                        </table>

                        <!-- third table -->
                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:20%;">Wagennummer Alt:</th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:14%;">Eigengewicht</th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:14%;"></th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:13%;">Art:</th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:13%;">Zyklus:</th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:13%;">Datum:</th>
                                    <th style="border:1px solid #000; padding:4px; font-weight:bold; width:13%;">Verlängerung:</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.equipment_line_ids">
                                    <t t-foreach="o.equipment_line_ids" t-as="equipment_line">
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px;">
                                                Alt nummer, Waar halen?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                gewicht, Waar halen?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; font-weight:bold; background:#f2f2f2;">
                                                Revision
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                wat hier?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                wat? waar halen?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                Datum? waar halen?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                +3M?? wat?waar?
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; font-weight:bold; background:#f2f2f2;">
                                                Bremrevision
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; font-weight:bold;">
                                                BR0 wat hier?
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; font-weight:bold; background:#f2f2f2;">
                                                Frist
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; font-weight:bold;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                            <td style="border:1px solid #000; padding:4px;">
                                                
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Work performed -->
                        <div style="background:#e6e6e6; border:1px solid #000; border-bottom:0; padding:4px; font-weight:bold; text-transform:uppercase;">
                            Durchgeführte Instandsetzungsarbeiten
                        </div>

                        <table style="width:100%; border-collapse:collapse; border:1px solid #000; margin-bottom:6px;">
                        
                            <!-- Completed FSM activities -->
                            <t t-if="o.fsm_order_id.order_activity_ids.filtered(lambda activity: activity.state == 'done')">
                                <t t-foreach="o.fsm_order_id.order_activity_ids" t-as="activity">
                                    <t t-if="activity.state == 'done'">
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <t t-if="activity.ref">
                                                    <strong><span t-field="activity.ref"/></strong>
                                                    —
                                                </t>
                                                <span t-field="activity.name"/>
                        
                                                <t t-if="activity.completed_on">
                                                    <span style="float:right; color:#555;">
                                                        Completed:
                                                        <span t-field="activity.completed_on"
                                                              t-options='{"widget": "datetime"}'/>
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        
                                <t t-if="o.contractor_cost_line_ids">
                                    <t t-foreach="o.contractor_cost_line_ids" t-as="cost_line">
                                        <tr>
                                            <td>
                                                <span t-field="cost_line.product_id"/> <b>Qty:</b> <span t-field="cost_line.quantity"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="5">
                                            No contractor-cost lines recorded.
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="o.timesheet_line_ids">
                                    <t t-foreach="o.timesheet_line_ids" t-as="time_line">
                                        <tr>
                                            <td>
                                                <span t-field="time_line.product_id"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px;" colspan="6">
                                            No employee-timesheet lines recorded.
                                        </td>
                                    </tr>
                                </t>
                        </table>



