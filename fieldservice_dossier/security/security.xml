<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dossier_approver" model="res.groups">
        <field name="name">Dossier Approver</field>
        <field name="implied_ids" eval="[(4, ref('fieldservice.group_fsm_user'))]"/>
    </record>

    <record id="rule_fsm_dossier_company" model="ir.rule">
        <field name="name">FSM Dossier: multi-company</field>
        <field name="model_id" ref="model_fsm_dossier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fsm_dossier_inspection_company" model="ir.rule">
        <field name="name">FSM Dossier Inspection: multi-company</field>
        <field name="model_id" ref="model_fsm_dossier_inspection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
