<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_dossier_inspection_type_list" model="ir.ui.view">
        <field name="name">fsm.dossier.inspection.type.list</field>
        <field name="model">fsm.dossier.inspection.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_approval"/>
                <field name="auto_add"/>
                <field name="required_default"/>
                <field name="validity_months"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_fsm_dossier_inspection_type" model="ir.actions.act_window">
        <field name="name">Inspection Types</field>
        <field name="res_model">fsm.dossier.inspection.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
