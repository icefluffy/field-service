<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_dossier_inspection_list" model="ir.ui.view">
        <field name="name">fsm.dossier.inspection.list</field>
        <field name="model">fsm.dossier.inspection</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="not required">
                <field name="equipment_id"/>
                <field name="dossier_id"/>
                <field name="type_id"/>
                <field name="required"/>
                <field name="order_id"/>
                <field name="person_id"/>
                <field name="work_status" widget="badge"
                                           decoration-success="work_status == 'done'"/>
                <field name="result" widget="badge"
                                           decoration-success="result == 'passed'"
                                           decoration-warning="result == 'remarks'"
                                           decoration-danger="result == 'failed'"/>
                <field name="date_performed"/>
                <field name="valid_until"/>
            </list>
        </field>
    </record>
    <record id="fsm_dossier_inspection_form" model="ir.ui.view">
        <field name="name">fsm.dossier.inspection.form</field>
        <field name="model">fsm.dossier.inspection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="dossier_id"/>
                            <field name="equipment_id"/>
                            <field name="type_id"/>
                            <field name="is_approval" invisible="1"/>
                            <field name="required"/>
                            <field name="order_id" readonly="is_approval"/>
                        </group>
                        <group>
                            <field name="work_status" readonly="is_approval"/>
                            <field name="result" readonly="is_approval"/>
                            <field name="date_performed" readonly="is_approval"/>
                            <field name="valid_until"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_dossier_inspection_search" model="ir.ui.view">
        <field name="name">fsm.dossier.inspection.search</field>
        <field name="model">fsm.dossier.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="dossier_id"/>
                <field name="type_id"/>
                <field name="person_id"/>
                <filter name="required" string="Required" domain="[('required', '=', True)]"/>
                <filter name="open" string="Open"
                        domain="[('required', '=', True), ('work_status', 'not in', ('done', 'cancelled'))]"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                <filter name="expired" string="Validity expired"
                        domain="[('valid_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="g_type" string="Inspection" context="{'group_by': 'type_id'}"/>
                    <filter name="g_status" string="Work status" context="{'group_by': 'work_status'}"/>
                    <filter name="g_tech" string="Technician" context="{'group_by': 'person_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_fsm_dossier_inspection" model="ir.actions.act_window">
        <field name="name">Inspection Overview</field>
        <field name="res_model">fsm.dossier.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_required': 1, 'search_default_g_equipment': 1}</field>
    </record>
</odoo>
