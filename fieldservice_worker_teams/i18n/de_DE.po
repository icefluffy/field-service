#. module: fieldservice_worker_teams
#. odoo-python
#: code:addons/fieldservice_worker_teams/models/membership.py:0
msgid ""
"A company-specific worker can only join teams of that company. Use a shared "
"worker contact (Company empty) if membership across companies is required."
msgstr ""
"Ein unternehmensspezifischer Mitarbeiter kann nur Teams dieses Unternehmens "
"beitreten. Verwenden Sie einen gemeinsamen Mitarbeiter (Unternehmen leer), "
"wenn eine unternehmensübergreifende Mitgliedschaft nötig ist."

#. module: fieldservice_worker_teams
#. odoo-python
#: code:addons/fieldservice_worker_teams/models/membership.py:0
msgid ""
"A team can contain shared workers or workers belonging to the same company "
"as the team."
msgstr ""
"Ein Team kann gemeinsame Mitarbeiter oder Mitarbeiter desselben Unternehmens"
" wie das Team enthalten."

#. module: fieldservice_worker_teams
#: model:ir.model,name:fieldservice_worker_teams.model_res_partner
msgid "Contact"
msgstr "Kontakt"

