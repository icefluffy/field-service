#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid container Serial # %(serial)s: expected four letters followed by "
"seven digits, for example HLMU2510167."
msgstr ""
"Ungültige Containernummer %(serial)s: erwartet werden vier Buchstaben "
"gefolgt von sieben Ziffern, zum Beispiel HLMU2510167."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid container Serial # %(serial)s: the last digit must be %(expected)s."
msgstr ""
"Ungültige Containernummer %(serial)s: die letzte Ziffer muss %(expected)s "
"sein."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid rail vehicle Serial # %(serial)s: enter 12 digits, optionally with "
"spaces or hyphens."
msgstr ""
"Ungültige Seriennummer des Schienenfahrzeugs %(serial)s: geben Sie 12 "
"Ziffern ein, optional mit Leerzeichen oder Bindestrichen."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid rail vehicle Serial # %(serial)s: the last digit must be "
"%(expected)s."
msgstr ""
"Ungültige Seriennummer des Schienenfahrzeugs %(serial)s: die letzte Ziffer "
"muss %(expected)s sein."

