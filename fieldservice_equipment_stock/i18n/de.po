#. module: fieldservice_equipment_stock
#: model:ir.model.fields,field_description:fieldservice_equipment_stock.field_stock_picking_type__create_fsm_equipment
msgid "Create Fsm Equipment"
msgstr "Service-Equipment anlegen"

#. module: fieldservice_equipment_stock
#: model:ir.model.fields,field_description:fieldservice_equipment_stock.field_product_product__create_fsm_equipment
#: model:ir.model.fields,field_description:fieldservice_equipment_stock.field_product_template__create_fsm_equipment
msgid "Creates a FSM Equipment"
msgstr "Legt ein Service-Equipment an"

#. module: fieldservice_equipment_stock
#: model:ir.model.fields,help:fieldservice_equipment_stock.field_product_product__create_fsm_equipment
#: model:ir.model.fields,help:fieldservice_equipment_stock.field_product_template__create_fsm_equipment
msgid ""
"Creates a Field Service Equipment when a stock move is done. It requires the"
" 'Create FSM Equipment' option to be enabled on the picking type, too."
msgstr ""
"Legt ein Service-Equipment an, wenn eine Lagerbuchung erledigt wird. Dazu "
"muss auch die Option „Service-Equipment anlegen“ am Vorgangstyp aktiviert "
"sein."

