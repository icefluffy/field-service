msgstr "Numéro de série invalide"

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid container Serial # %(serial)s: expected four letters followed by "
"seven digits, for example HLMU2510167."
msgstr ""
"Numéro de conteneur %(serial)s invalide : quatre lettres suivies de sept "
"chiffres attendues, par exemple HLMU2510167."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid container Serial # %(serial)s: the last digit must be %(expected)s."
msgstr ""
"Numéro de conteneur %(serial)s invalide : le dernier chiffre doit être "
"%(expected)s."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid rail vehicle Serial # %(serial)s: enter 12 digits, optionally with "
"spaces or hyphens."
msgstr ""
"Numéro de série de véhicule ferroviaire %(serial)s invalide : saisissez 12 "
"chiffres, éventuellement avec des espaces ou des tirets."

#. module: fieldservice_equipment_stock
#. odoo-python
#: code:addons/fieldservice_equipment_stock/models/fsm_equipment.py:0
msgid ""
"Invalid rail vehicle Serial # %(serial)s: the last digit must be "
"%(expected)s."
msgstr ""
"Numéro de série de véhicule ferroviaire %(serial)s invalide : le dernier "
"chiffre doit être %(expected)s."

