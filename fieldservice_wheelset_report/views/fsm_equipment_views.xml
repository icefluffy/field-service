<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_equipment_form_wheelset_report" model="ir.ui.view">
        <field name="name">fsm.equipment.form.wheelset.report</field>
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wheelset_ids']/.." position="after">
                <page string="Wheelset records" name="wheelset_reports">
                    <field name="wheelset_report_ids" readonly="1" nolabel="1">
                        <list decoration-muted="state == 'replaced'"
                              decoration-success="state == 'done'">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="order_id"/>
                            <field name="dossier_id"/>
                            <field name="lot_id" optional="hide"/>
                            <field name="filled_by_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
