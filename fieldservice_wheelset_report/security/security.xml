<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_wheelset_report_company" model="ir.rule">
        <field name="name">Wheelset record: multi-company</field>
        <field name="model_id" ref="model_fsm_wheelset_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wheelset_report_line_company" model="ir.rule">
        <field name="name">Wheelset record line: multi-company</field>
        <field name="model_id" ref="model_fsm_wheelset_report_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
