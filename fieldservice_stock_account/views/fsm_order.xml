<odoo>
    <record id="fsm_order_form_stock_account" model="ir.ui.view">
        <field name="name">fsm.order.form.stock.account</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice_isp_account.fsm_order_form_isp_account"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contractor_cost_ids']" position="before">
                <div colspan="2" class="text-end">
                    <button name="action_sync_delivered_materials"
                            type="object"
                            string="Copy Delivered Materials"
                            icon="fa-refresh"
                            class="btn-link"
                            invisible="account_stage == 'invoiced'"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
