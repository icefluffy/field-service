<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="rule_intake_company" model="ir.rule"><field name="name">Intake company</field><field name="model_id" ref="model_fsm_wagon_intake"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_intake_line_company" model="ir.rule"><field name="name">Intake line company</field><field name="model_id" ref="model_fsm_wagon_intake_line"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <!-- Inbound inspection: one scrolling page (no tabs) so it is easy to fill in
      on a phone or tablet. The sections follow the order the technician works
      in and end with a large "Complete inspection" button. -->
 <record id="intake_form" model="ir.ui.view">
  <field name="name">fsm.wagon.intake.form</field><field name="model">fsm.wagon.intake</field>
  <field name="arch" type="xml">
    <form delete="0" duplicate="0">
        <header>
            <button name="action_complete" string="Complete inspection" type="object" class="btn-primary" invisible="state not in ('draft','progress')"/>
            <button name="action_reopen" string="Reopen" type="object" invisible="state in ('draft','progress')" confirm="The inspection will be reopened. Any dossier approval will lapse."/>
            <field name="state" widget="statusbar" statusbar_visible="draft,progress,done"/>
        </header>
        <sheet>
            <div class="oe_title">
                <h1><field name="name"/></h1>
            </div>
            <group>
                <group>
                    <field name="inspection_id" invisible="1"/>
                    <field name="dossier_id"/>
                </group>
                <group>
                    <field name="equipment_id"/>
                    <field name="order_id"/>
                    <field name="source_reference" invisible="1"/>
                </group>
            </group>

            <group string="1. Wagon and inspection">
                <group>
                    <field name="inspection_date" readonly="state not in ('draft','progress')"/>
                    <field name="inspector_id" readonly="state not in ('draft','progress')"/>
                    <field name="keeper_id" readonly="state not in ('draft','progress')"/>
                    <field name="customer_type" readonly="state not in ('draft','progress')"/>
                </group>
                <group>
                    <field name="uic" readonly="state not in ('draft','progress')"/>
                    <field name="revision_mark" readonly="state not in ('draft','progress')"/>
                    <field name="revision_date" readonly="state not in ('draft','progress')"/>
                    <field name="tare_kg" readonly="state not in ('draft','progress')"/>
                </group>
            </group>

            <group string="2. Brake and handbrake">
                <group>
                    <field name="brake_inscription" readonly="state not in ('draft','progress')"/>
                    <field name="brake_block_type" readonly="state not in ('draft','progress')"/>
                </group>
                <group>
                    <field name="handbrake_t" readonly="state not in ('draft','progress')"/>
                    <field name="handbrake_kn" readonly="state not in ('draft','progress')"/>
                    <field name="handbrake_percent" readonly="state not in ('draft','progress')"/>
                </group>
            </group>

            <!-- 3. Load limit raster, drawn like the plate on the wagon side
                 wall, with the stars next to it as on the plate. -->
            <separator string="3. Load limit raster"/>
            <div class="d-flex flex-wrap align-items-start gap-3 mb-2">
                <field name="load_grid" widget="fsm_load_grid" nolabel="1" class="mw-100"
                       readonly="state not in ('draft','progress')"/>
                <div class="o_fsm_load_stars">
                    <div class="small text-muted">Stars next to the raster</div>
                    <field name="load_stars" widget="priority" nolabel="1" options="{'autosave': false}"
                           readonly="state not in ('draft','progress')"/>
                </div>
            </div>
            <div class="small text-muted mb-2" invisible="load_stars in (False, '0')">
                <field name="load_stars" readonly="1" nolabel="1"/>
            </div>
            <field name="load_grid_has_errors" invisible="1"/>
            <field name="load_grid_issues" nolabel="1" readonly="1" invisible="not load_grid_issues"/>
            <group>
                <group>
                    <field name="load_photo" widget="image" options="{'size': [0, 180]}"
                           readonly="state not in ('draft','progress')"/>
                </group>
                <group>
                    <field name="load_notes" readonly="state not in ('draft','progress')"/>
                </group>
            </group>

            <group string="4. Inscriptions and labels">
                <field name="maintenance_inscriptions" readonly="state not in ('draft','progress')"/>
                <field name="revision_plates" readonly="state not in ('draft','progress')" widget="radio" options="{'horizontal': true}"/>
                <field name="reason" readonly="state not in ('draft','progress')"/>
                <field name="extra" readonly="state not in ('draft','progress')"/>
            </group>

            <separator string="5. Findings"/>
            <div class="text-muted small mb-2" invisible="state not in ('draft','progress')">
                Assess every component: OK, Defect or Not applicable. For a defect, enter the finding and the quantity.
            </div>
            <!-- One card per component on every screen size, with OK / Defect /
                 N/A buttons. Defect opens the finding to enter the defect and
                 quantity; tapping a card opens it for an optional explanation. -->
            <field name="line_ids" mode="kanban" class="o_fsm_findings" readonly="state not in ('draft','progress')">
                <kanban create="0" delete="0">
                    <field name="check_state"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_fsm_finding_card">
                                <div class="o_fsm_finding_head d-flex justify-content-between align-items-start gap-2">
                                    <field name="component" class="fw-bold"/>
                                    <span t-attf-class="o_fsm_state_badge o_fsm_state_#{record.check_state.raw_value} badge rounded-pill flex-shrink-0"
                                          t-out="record.check_state.value"/>
                                </div>
                                <div class="o_fsm_finding_meta text-muted small">
                                    <field name="code" class="me-2"/>
                                    <field name="section"/>
                                </div>
                                <field name="check_state" widget="fsm_check_state_buttons" class="o_fsm_finding_buttons mt-2"/>
                                <div class="o_fsm_finding_detail">
                                    <div invisible="check_state != 'defect' or not defect" class="text-danger small mt-1">
                                        <field name="quantity"/> × <field name="defect"/>
                                    </div>
                                    <div invisible="not note" class="small">
                                        <field name="note"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
                <form>
                    <div class="oe_title">
                        <h2><field name="component" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="section" readonly="1"/>
                        <field name="code" readonly="1"/>
                        <field name="check_state" widget="radio"/>
                        <field name="defect" required="check_state == 'defect'"/>
                        <field name="quantity"/>
                        <field name="note"/>
                    </group>
                </form>
            </field>

            <group string="6. Result">
                <field name="remarks" readonly="state not in ('draft','progress')"/>
                <field name="outcome_note" readonly="state not in ('draft','progress')"/>
                <field name="recorded_by" invisible="not recorded_by"/>
                <field name="recorded_at" invisible="not recorded_at"/>
            </group>

            <div class="mt-4 mb-2" invisible="state not in ('draft','progress')">
                <button name="action_complete" string="Complete inspection" type="object" class="btn btn-primary btn-lg w-100"/>
            </div>
        </sheet>
        <chatter/>
    </form>
  </field>
 </record>
<record id="inspection_form_intake" model="ir.ui.view">
    <field name="name">inspection.form.intake</field>
    <field name="model">fsm.dossier.inspection</field>
    <field name="inherit_id"
           ref="fieldservice_dossier.fsm_dossier_inspection_form"/>

    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <field name="is_wagon_intake" invisible="1"/>
            <button name="action_open_wagon_intake"
                    string="Open Inbound inspection"
                    type="object"
                    invisible="not is_wagon_intake"/>
        </xpath>
    </field>
</record>
 <record id="dossier_form_intake" model="ir.ui.view">
    <field name="name">dossier.form.intake</field>
    <field name="model">fsm.dossier</field>
    <field name="inherit_id"
           ref="fieldservice_dossier.fsm_dossier_form"/>

    <field name="arch" type="xml">
        <xpath expr="//field[@name='inspection_ids']/list"
               position="inside">

            <field name="is_wagon_intake" column_invisible="1"/>

            <button name="action_open_wagon_intake"
                    type="object"
                    string="Open Inbound inspection"
                    icon="fa-list-alt"
                    invisible="not is_wagon_intake"/>
        </xpath>
    </field>
</record>
 <record id="order_form_intake" model="ir.ui.view"><field name="name">fsm.order.form.intake</field><field name="model">fsm.order</field><field name="inherit_id" ref="fieldservice.fsm_order_form"/>
 <field name="arch" type="xml">
    <!-- At the top of the sheet, not in the header: on phones Odoo moves
         header buttons into the gear menu. Orange while open, green when done. -->
    <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
        <field name="has_wagon_intake" invisible="1"/>
        <field name="wagon_intake_state" invisible="1"/>
        <div class="o_fsm_wagon_intake_button d-grid d-md-block mb-3" invisible="not has_wagon_intake">
            <button name="action_open_wagon_intake" type="object"
                    string="Inbound inspection" icon="fa-clipboard"
                    class="btn btn-lg btn-warning"
                    invisible="wagon_intake_state == 'done'"/>
            <button name="action_open_wagon_intake" type="object"
                    string="Inbound inspection" icon="fa-check"
                    class="btn btn-lg btn-success"
                    invisible="wagon_intake_state != 'done'"/>
        </div>
    </xpath>
 </field></record>
</odoo>
