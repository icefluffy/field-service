<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_fsm_client_order" model="ir.ui.view">
        <field name="name">sale.order.form.fsm.client.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_cancel" position="before">
                <button name="action_fsm_back_to_quotation" string="Back to quotation"
                        type="object"
                        invisible="state != 'sale' or not (fsm_client_order_id or fsm_dossier_id)"
                        confirm="Set this order back to quotation to change it?"/>
            </button>
            <group name="order_details" position="inside">
                <field name="fsm_client_order_id" invisible="not fsm_client_order_id"/>
                <field name="fsm_dossier_id" invisible="not fsm_dossier_id"/>
            </group>
        </field>
    </record>

    <record id="view_sales_order_filter_fsm_client_order" model="ir.ui.view">
        <field name="name">sale.order.search.fsm.client.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="fsm_client_order_id"/>
                <field name="fsm_dossier_id"/>
            </field>
        </field>
    </record>
</odoo>
