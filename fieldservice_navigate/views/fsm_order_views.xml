<odoo>
    <record id="view_fsm_order_form_navigate" model="ir.ui.view">
        <field name="name">fsm.order.form.navigate.inherit</field>
        <field name="model">fsm.order</field>
        <!-- Instead of a hardcoded external id (which differs between
             versions/forks), look up the primary form view for fsm.order
             by domain. This finds whatever your instance actually calls it. -->
        <field name="inherit_id"
               search="[('model','=','fsm.order'),('type','=','form'),('mode','=','primary')]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <button name="action_open_google_maps"
                        type="object"
                        string="Navigate"
                        icon="fa-map-marker"
                        class="btn-link"
                        invisible="not location_id"/>
            </xpath>
        </field>
    </record>
</odoo>
