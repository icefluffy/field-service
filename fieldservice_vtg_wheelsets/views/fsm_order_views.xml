<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_form_wheelsets" model="ir.ui.view">
        <field name="name">fsm.order.form.wheelsets</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page name="wheelsets_overview" string="Wheelsets">
                    <group>
                        <field name="wheelset_ids" nolabel="1">
                            <list create="0" edit="1" delete="0">
                                <field name="position"/>
                                <field name="serial_number"/>
                                <field name="wheelset_type"/>
                                <field name="ton"/>
                                <field name="last_input_date"/>
                                <field name="new_input_date"/>
                            </list>
                        </field>
        
                        <button
                            name="action_open_equipment"
                            string="Edit Equipment"
                            type="object"
                            class="oe_highlight"
                            invisible="not equipment_ids"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
