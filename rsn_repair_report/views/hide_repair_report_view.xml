<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_order_form_hide_repair_report" model="ir.ui.view">
        <field name="name">fsm.order.form.hide.repair.report</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='repair_report']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>