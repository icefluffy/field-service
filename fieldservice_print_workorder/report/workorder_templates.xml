<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_workorder_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="fieldservice_print_workorder.workorder_layout">
                    <t t-set="customer" t-value="order._get_workorder_customer()"/>
                </t>
            </t>
        </t>
    </template>

    <template id="workorder_layout">
        <t t-call="web.basic_layout">
            <div class="page workorder-page">
            <style>
                .workorder-page { font-family: Arial, sans-serif; font-size: 10px; color: #111; }
                .workorder-header { border-bottom: 2px solid #111; padding: 4px 0 6px; margin-bottom: 8px; font-size: 15px; overflow: hidden; }
                .header-left { float: left; }
                .header-right { float: right; font-size: 10px; }
                table { width: 100%; border-collapse: collapse; }
                .identification-table td, .technical-table td { border: 1px solid #777; padding: 5px; }
                .label { font-weight: bold; background: #f1f1f1; white-space: nowrap; }
                .large { font-size: 14px; font-weight: bold; }
                .instruction { font-weight: bold; margin: 10px 0 4px; }
                .task-table th, .task-table td { border-bottom: 1px solid #aaa; padding: 5px; height: 20px; }
                .task-table th { background: #eee; text-align: left; }
                .status-column { width: 25px; }
                .quantity-column { width: 55px; text-align: center; }
                .ok-column { width: 45px; text-align: center; }
                .checkbox { border: 1px solid #555; width: 18px; height: 18px; }
                .extra-work { margin-top: 10px; overflow: hidden; }
                .vertical-label { float: left; width: 85px; font-weight: bold; }
                .extra-work-box { margin-left: 90px; height: 145px; border: 1px solid #777; padding: 8px; }
                .completion-table { margin-top: 10px; }
                .completion-table td { padding: 5px; }
                .completion-question { font-weight: bold; }
                .remarks { margin-top: 8px; overflow: hidden; }
                .remarks strong { float: left; width: 75px; }
                .remarks-box { margin-left: 80px; border: 1px solid #777; height: 28px; padding: 5px; }
                .technical-table { margin-top: 10px; }
                .technical-info { border-top: 18px solid #aaa; min-height: 80px; margin-top: 8px; padding-top: 8px; }
                .footer-line { border-top: 1px solid #111; padding-top: 5px; margin-top: 8px; overflow: hidden; }
                .footer-line span:last-child { float: right; }
                .company-footer { border-top: 1px solid #aaa; margin-top: 8px; padding-top: 8px; font-size: 9px; }
                .company-logo img { max-height: 35px; max-width: 150px; }
            </style>
                <div class="workorder-header">
                    <div class="header-left">
                        <strong>Work Order</strong>
                    </div>
                    <div class="header-right">
                        <strong>Print date:</strong>
                        <span t-esc="order.create_date.strftime('%d/%m/%Y') if order.create_date else ''"/>
                    </div>
                </div>

                <table class="identification-table">
                    <tr>
                        <td class="label">Object no.:</td>
                        <td class="value large">
                            <span t-esc="order.equipment_ids[:1].lot_id.name or ''"/>
                        </td>
                        <td class="label">KI-ID:</td>
                        <td class="value"></td>
                        <td class="label">SO:</td>
                        <td class="value">
                            <span t-esc="order.name or ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="label">Codes:</td>
                        <td class="value">
                            <span t-esc="order.x_maintenance_level or ''"/>
                        </td>
                        <td class="label">FW:</td>
                        <td class="value">
                            <span t-esc="order.x_fw_number or ''"/>
                        </td>
                        <td class="label">Customer:</td>
                        <td class="value">
                            <span t-esc="customer.name if customer else ''"/>
                        </td>
                    </tr>
                </table>

                <p class="instruction">
                    Note the correct quantities. Change or add where necessary.
                    Tick OK only if completed; otherwise leave blank.
                </p>

                <table class="task-table">

                </table>

                <div class="extra-work">
                    <div class="vertical-label">
                        Extra work<br/>
                        and material:
                    </div>
                    <table>
                    <div class="extra-work-box">
                        <t t-if="order.description">
                            <span t-field="order.description"/>
                        </t>
                    </div>
                    </table>
                </div>

                <table class="completion-table">
                    <tr>
                        <td class="completion-question">
                            Fully repaired and required inspections completed?
                        </td>
                        <td class="check-option">☐ YES</td>
                        <td class="check-option">☐ NO</td>
                        <td class="check-option">☐ NOT PERFORMED</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan="3">
                            ☐ Work performed, but additional work remains;
                            object is NOT ready
                        </td>
                    </tr>
                </table>

                <div class="remarks">
                    <strong>Remarks:</strong>
                    <div class="remarks-box">
                        <t t-if="order.resolution">
                            <span t-field="order.resolution"/>
                        </t>
                    </div>
                </div>

                <table class="technical-table">
                    <tr>
                        <td class="label">Keeper:</td>
                        <td>
                            <span t-esc="customer.name if customer else ''"/>
                        </td>
                        <td class="label">Revision frame:</td>
                        <td>
                            <span t-esc="order.x_revision_cycle or ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="label">UIC code:</td>
                        <td>
                            <span t-esc="order.x_wagon_number or ''"/>
                        </td>
                        <td class="label">Tare:</td>
                        <td>
                            <span t-esc="order.x_own_weight or ''"/>
                            kg
                        </td>
                    </tr>
                    <tr>
                        <td class="label">Customer type:</td>
                        <td></td>
                        <td class="label">Start:</td>
                        <td>
                            <span t-esc="order.date_start or ''"/>
                        </td>
                        <td class="label">End:</td>
                        <td>
                            <span t-esc="order.date_end or ''"/>
                        </td>
                    </tr>
                </table>

                <div class="technical-info">
                    <strong>Technical info:</strong>
                </div>

                <div class="footer-line">
                    <span>
                        Order:
                        <t t-esc="order.name"/>
                    </span>
                    <span>
                        Page 1 of 1
                    </span>
                </div>

                <div class="company-footer">
                    <div class="company-logo">
                        <img
                            t-if="order.company_id.logo"
                            t-att-src="image_data_uri(order.company_id.logo)"
                        />
                    </div>
                    <div>
                        <strong t-esc="order.company_id.name"/>
                        <br/>
                        <span t-esc="order.company_id.street or ''"/>
                        <br/>
                        <span t-esc="order.company_id.zip or ''"/>
                        <span t-esc="order.company_id.city or ''"/>
                        <br/>
                        <span t-esc="order.company_id.phone or ''"/>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>