<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_workorder_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="fieldservice_print_workorder.workorder_layout">
                    <t t-set="customer" t-value="order._get_workorder_customer()"/>
                </t>
            </t>
        </t>
    </template>

    <template id="workorder_layout">
        <t t-call="web.basic_layout">
            <t t-set="raw" t-value="(order.equipment_ids[:1].lot_id.name or '').replace(' ', '').replace('-', '')"/>
            <t t-set="wagon" t-value="(raw[0:2] + ' ' + raw[2:4] + ' ' + raw[4:8] + ' ' + raw[8:11] + ' ' + raw[11:]) if len(raw) == 12 else raw"/>
            <t t-set="workers" t-value="', '.join((order.person_id | order.person_ids).mapped('name'))"/>

            <style>
                .wo { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000; }
                .wo table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                .wo td { vertical-align: middle; padding: 2px 3px; }
                .wo .title { font-size: 22px; font-weight: bold; }
                .wo .lbl { font-weight: bold; font-size: 12px; white-space: nowrap; }
                .wo .small { font-size: 8px; font-style: italic; }
                .wo .box { border: 1px solid #000; height: 20px; padding: 1px 4px; font-size: 12px; }
                .wo .box-thick { border: 2px solid #000; height: 22px; padding: 1px 4px; font-size: 14px; }
                .wo .grey { background: #d9d9d9; }
                .wo .rule { border-top: 3px solid #000; margin: 8px 0 6px 0; }
                .wo .rule-thin { border-top: 1px solid #000; margin: 6px 0; }
                .wo .legal { font-size: 8px; text-align: justify; line-height: 1.25; margin: 6px 0; }
                .wo .cb { display: inline-block; width: 12px; height: 12px; border: 1px solid #000; background: #d9d9d9; vertical-align: middle; margin-right: 4px; }
                .wo .ok-box { width: 20px; height: 20px; border: 1px solid #000; display: inline-block; }
                .wo .right { text-align: right; }
                .wo .center { text-align: center; }
                .wo .extra-box { border: 1px solid #000; height: 330px; padding: 4px; font-size: 12px; }
                .wo .activities { min-height: 40px; }
                .wo .tech-bar { background: #d9d9d9; font-size: 8px; font-style: italic; font-weight: bold; padding: 2px 4px; }
            </style>

            <div class="page wo">

                <table>
                    <tr>
                        <td style="width:35%"><span class="title">Work Order</span></td>
                        <td style="width:35%" class="center">
                            <span class="lbl">Planned date:</span>
                            <span class="box grey" style="display:inline-block; width:110px; text-align:center;">
                                <t t-if="order.scheduled_date_start">
                                    <t t-esc="context_timestamp(order.scheduled_date_start).strftime('%d/%m/%Y')"/>
                                </t>
                            </span>
                        </td>
                        <td style="width:30%"></td>
                    </tr>
                </table>

                <table style="margin-top:6px;">
                    <tr>
                        <td style="width:20%">
                            <div class="lbl">Technicians:</div>
                            <div class="small">Full names or registered abbreviation</div>
                        </td>
                        <td style="width:80%"><div class="box grey"><t t-esc="workers"/></div></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td style="font-size:12px; font-style:italic;">The technician named on the left checks and signs after completion.</td>
                    </tr>
                </table>

                <table style="margin-top:4px;">
                    <tr>
                        <td style="width:28%" class="lbl">Signature after completion:</td>
                        <td style="width:30%"><div class="box-thick"></div></td>
                        <td style="width:14%" class="lbl right">Completion date:</td>
                        <td style="width:28%"><div class="box-thick center">/ &#160;&#160;&#160; /</div></td>
                    </tr>
                </table>

                <div class="legal">
                    A freight wagon marked as OK must comply with the requirements of the order and, as a minimum, for work according to GCU, with the requirements of GCU Annex 10, or, for work according to VPI and insofar as the data is known, with VPI 01 Annex 19 (present, complete and legible markings, pictograms and warning signs; underframe and bogie visually free of cracks and deformation; buffing and draw gear visually free of cracks and deformation; axle securing compliant; brake components visually free of cracks and deformation; steps, supports, handrails, ladders and signal holders secure and visually free of cracks and deformation; drag hook, cable eye and protective bracket visually free of cracks and deformation / undamaged; wheelsets visually undamaged; brake blocks not running alongside, not broken, &gt;15 mm for cast iron, &gt;13 mm for K/LL; lubricated; revision valid; other maintenance frameworks valid).
                </div>

                <div class="rule"></div>

                <table>
                    <tr>
                        <td style="width:10%"><div class="box-thick lbl" style="font-size:15px;">Location:</div></td>
                        <td style="width:40%"><div class="box-thick"><t t-esc="order.location_id.name or ''"/></div></td>
                        <td style="width:22%" class="right lbl">Start:</td>
                        <td style="width:12%"><div class="box"><t t-esc="order.date_start or 'none'"/></div></td>
                        <td style="width:4%" class="right lbl">End:</td>
                        <td style="width:12%"><div class="box"><t t-esc="order.date_end or ''"/></div></td>
                    </tr>
                </table>
                <table style="margin-top:2px;">
                    <tr>
                        <td style="width:10%" class="lbl"><i>Address:</i></td>
                        <td style="width:90%; font-size:12px;">
                            <t t-esc="order.street or ''"/>
                            <t t-if="order.city">, <t t-esc="order.city"/></t>
                        </td>
                    </tr>
                    <tr>
                        <td class="lbl"><i>Remarks:</i></td>
                        <td><div class="box grey" style="height:28px;"><t t-esc="order._get_workorder_location_directions()"/></div></td>
                    </tr>
                </table>

                <div class="rule"></div>

                <table>
                    <tr>
                        <td style="width:9%"><div class="box lbl">SO no.:</div></td>
                        <td style="width:20%"><div class="box grey right"><t t-esc="order.sale_id.client_order_ref or order.customer_reference or order.x_customer_order_ref or ''"/></div></td>
                        <td style="width:8%"><div class="box lbl">Customer:</div></td>
                        <td style="width:38%"><div class="box"><t t-esc="order.customer_id.name if order.customer_id else ''"/></div></td>
                        <td style="width:7%" class="right lbl">Line:</td>
                        <td style="width:18%"><div class="box"></div></td>
                    </tr>
                </table>
                <table style="margin-top:2px;">
                    <tr>
                        <td style="width:9%"><div class="box lbl">Remarks:</div></td>
                        <td style="width:91%"><div class="box grey"></div></td>
                    </tr>
                </table>

                <div class="rule"></div>

                <table>
                    <tr>
                        <td style="width:14%" class="lbl">Object no.:</td>
                        <td style="width:34%"><div class="box-thick grey center" style="font-weight:bold; font-size:15px;"><t t-esc="wagon"/></div></td>
                        <td style="width:8%" class="lbl">KI-ID:</td>
                        <td style="width:14%"></td>
                        <td style="width:6%" class="lbl">SO:</td>
                        <td style="width:14%" class="lbl"><t t-esc="order.name"/></td>
                        <td style="width:10%" class="small">VW:</td>
                    </tr>
                    <tr>
                        <td class="lbl">Codes:</td>
                        <td>
                            <table>
                                <tr>
                                    <td style="width:50%"><div class="box"></div></td>
                                    <td style="width:50%"><div class="box"></div></td>
                                </tr>
                            </table>
                        </td>
                        <td><div class="box"></div></td>
                        <td></td>
                        <td class="lbl">Cr.:</td>
                        <td colspan="2"><t t-esc="order.create_uid.name or ''"/></td>
                    </tr>
                </table>

                <table style="margin-top:6px;">
                    <tr>
                        <td style="width:85%"><i>Note the correct quantities. Change / add where necessary. Tick OK ONLY if completed, otherwise leave BLANK.</i></td>
                        <td style="width:15%" class="right lbl">OK?</td>
                    </tr>
                </table>

                <div class="activities">
                    <!-- Activities from the activities tab will be added here later -->
                </div>

                <table style="margin-top:6px;">
                    <tr>
                        <td style="width:10%; vertical-align:top;" class="lbl">Extra<br/>work<br/>and<br/>mat.:</td>
                        <td style="width:90%">
                            <div class="extra-box"><t t-if="order.description"><span t-field="order.description"/></t></div>
                        </td>
                    </tr>
                </table>

                <table style="margin-top:8px;">
                    <tr>
                        <td style="width:45%" class="lbl">Fully repaired and required inspections carried out?</td>
                        <td style="width:15%" class="lbl"><span class="cb"></span>YES</td>
                        <td style="width:15%" class="lbl"><span class="cb"></span>NO</td>
                        <td style="width:25%" class="lbl"><span class="cb"></span>NOT PERFORMED</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan="3" class="lbl"><span class="cb"></span>Work performed but other work still to be carried out, object is NOT ready</td>
                    </tr>
                </table>

                <table style="margin-top:6px;">
                    <tr>
                        <td style="width:12%" class="lbl">Remark:</td>
                        <td style="width:88%"><div class="box" style="height:24px;"><t t-if="order.resolution"><span t-field="order.resolution"/></t></div></td>
                    </tr>
                </table>

                <table style="margin-top:6px;">
                    <tr>
                        <td style="width:9%; font-size:8px; vertical-align:top;">Incl. country code e.g. F-</td>
                        <td style="width:91%">
                            <div style="border:1px solid #000; padding:4px;">
                                <table>
                                    <tr>
                                        <td style="width:12%" class="lbl">Keeper:</td>
                                        <td style="width:34%">
                                            <table><tr>
                                                <td style="width:20%"><div class="box"></div></td>
                                                <td style="width:5%">-</td>
                                                <td style="width:75%"><div class="box"></div></td>
                                            </tr></table>
                                        </td>
                                        <td style="width:14%" class="lbl right">Revision frame:</td>
                                        <td style="width:40%"><div class="box"><t t-esc="order.x_revision_cycle or ''"/> <t t-if="order.x_revision_date"><t t-esc="order.x_revision_date"/></t></div></td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">UIC code:</td>
                                        <td><div class="box"><t t-esc="order.x_wagon_number or ''"/></div></td>
                                        <td class="lbl right">Tare:</td>
                                        <td>
                                            <table><tr>
                                                <td style="width:45%"><div class="box"><t t-if="order.x_own_weight"><t t-esc="int(order.x_own_weight)"/></t></div></td>
                                                <td style="width:55%">&#160;kg</td>
                                            </tr></table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Customer type:</td>
                                        <td><div class="box"></div></td>
                                        <td class="lbl right">Start:</td>
                                        <td>
                                            <table><tr>
                                                <td style="width:30%"><div class="box"></div></td>
                                                <td style="width:30%" class="lbl right">End:</td>
                                                <td style="width:40%"><div class="box"></div></td>
                                            </tr></table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="tech-bar" style="margin-top:2px;">CHECK data and ADJUST where necessary.</div>

                <table style="margin-top:8px;">
                    <tr>
                        <td style="width:10%; vertical-align:top;" class="lbl">Tech<br/>Info:</td>
                        <td style="width:90%; height:60px;"></td>
                    </tr>
                </table>

                <table style="margin-top:10px;">
                    <tr>
                        <td style="width:33%">Print: <t t-esc="time.strftime('%d/%m/%Y')"/></td>
                        <td style="width:45%">Print ID: <t t-esc="user.login"/>-<t t-esc="order.name"/>-<t t-esc="order.id"/></td>
                        <td style="width:22%" class="right">Page 1 of 1</td>
                    </tr>
                </table>

                <table style="margin-top:4px; font-size:9px;">
                    <tr>
                        <td style="width:14%; vertical-align:top;">
                            <img t-if="order.company_id.logo" t-att-src="image_data_uri(order.company_id.logo)" style="max-height:35px; max-width:130px;"/>
                        </td>
                        <td style="width:30%; vertical-align:top;">
                            <t t-esc="order.company_id.name"/><br/>
                            <t t-esc="order.company_id.street or ''"/><br/>
                            <t t-esc="order.company_id.zip or ''"/> <t t-esc="order.company_id.city or ''"/><br/>
                            <t t-if="order.company_id.vat">VAT: <t t-esc="order.company_id.vat"/></t>
                        </td>
                        <td style="width:56%; vertical-align:top;">
                            Location: <t t-esc="order.location_id.name or ''"/> &#160;&#160;&#160; Address: <t t-esc="order.street or ''"/>, <t t-esc="order.city or ''"/><br/>
                            Address remarks:
                        </td>
                    </tr>
                </table>

            </div>
        </t>
    </template>
</odoo>