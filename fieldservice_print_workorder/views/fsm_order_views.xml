<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_form_workorder_print" model="ir.ui.view">
        <field name="name">fsm.order.form.workorder.print</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_preview_workorder"
                    string="Print Preview Workorder"
                    type="object"
                />
                <button
                    name="action_print_workorder"
                    string="Print Work Order"
                    type="object"
                    class="oe_highlight"
                />
                <field name="show_report_button" invisible="1"/>
                <button
                    name="action_preview_report"
                    string="Report"
                    type="object"
                    icon="fa-file-text-o"
                    invisible="not show_report_button"
                />
            </xpath>
            <xpath expr="//group[@name='resolution_grp']" position="after">
                <group string="Report Comment" name="report_comment_grp">
                    <field
                        name="report_comment"
                        nolabel="1"
                        colspan="2"
                        placeholder="Comment shown on the customer report..."
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>