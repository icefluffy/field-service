<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_wagon_intake" model="report.paperformat">
        <field name="name">A4 portrait - Ingangsschouwing</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_wagon_intake" model="ir.actions.report">
        <field name="name">Inbound inspection</field>
        <field name="model">fsm.wagon.intake</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fieldservice_dossier_wagon_intake_report.report_wagon_intake</field>
        <field name="report_file">fieldservice_dossier_wagon_intake_report.report_wagon_intake</field>
        <field name="print_report_name">'%s - %s' % (object.equipment_id.name or '', object.inspection_date or '')</field>
        <field name="binding_model_id" ref="fieldservice_dossier_wagon_intake.model_fsm_wagon_intake"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_wagon_intake"/>
    </record>
</odoo>
